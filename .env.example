PRESTOCKS_API_URL=https://prestocks.com/api/prestocks
# Server-only key for Jupiter Swap API V2 order and execute calls.
JUPITER_API_KEY=

# Server-only Solana mainnet RPC used for read-only balance queries.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Canonical public origin used for SIWS domain and same-origin checks.
APP_URL=http://localhost:3000

# Required for authentication. Generate at least 32 random bytes, for example:
# openssl rand -base64 32
SESSION_SECRET=
