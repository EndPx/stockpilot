{
  "name": "stockpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && pnpm --filter @stockpilot/web build",
    "dev": "pnpm --filter @stockpilot/web dev",
    "start": "pnpm --filter @stockpilot/web start",
    "test": "tsx --test tests/*.test.ts && pnpm --filter @stockpilot/web test",
    "validate:mints": "tsx src/validate-mints.ts",
    "validate:xstocks": "tsx src/validate-xstocks.ts",
    "validate:execution": "tsx src/validate-execution.ts",
    "validate:investment-order": "tsx src/validate-investment-order.ts",
    "validate:portfolio-read": "pnpm --filter @stockpilot/web validate:portfolio-read"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@stockpilot/core": "workspace:*",
    "@stockpilot/integrations": "workspace:*",
    "@solana/kit": "^8.3.0"
  }
}
