PRESTOCKS_API_URL=https://prestocks.com/api/prestocks

# Server-only key for Jupiter Swap API V2 order and execute calls.
JUPITER_API_KEY=

# Server-only Solana mainnet RPC used for read-only balance queries.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Canonical public origin used for same-origin checks.
APP_URL=http://localhost:3000

# Build-time identity mode. Set to privy only for the dedicated cutover release.
# Public App ID is safe to expose; server secret must be configured separately.
NEXT_PUBLIC_AUTH_PROVIDER=siws
NEXT_PUBLIC_PRIVY_APP_ID=cmudnl6lc00lv0dl587wr6mj9
PRIVY_APP_SECRET=

# Required for authentication. Generate at least 32 random bytes and never
# commit the populated apps/web/.env.local file.
SESSION_SECRET=

# Production authentication requires Redis; it never falls back to memory.
# Development without Redis uses a bounded process-local store only.
AUTH_ENABLED=false
REDIS_URL=

# Only set behind a trusted reverse proxy which overwrites X-Real-IP.
TRUST_PROXY=false

# Always remains false in Privy mode until the new embedded-wallet signer path,
# transaction validation, reconciliation and mainnet acceptance are complete.
INVESTMENTS_ENABLED=false
